{
  "expo": {
    "name": "Ápice",
    "slug": "apice-black",
    "scheme": "apice",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0D0C",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0E0D0C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blackpremium.apice"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0D0C"
      },
      "package": "com.blackpremium.apice"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8B6914",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
